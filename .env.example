# Synthetic local defaults only. Copy to .env.local; never use in production.
SERVER_PORT=8091
DB_HOST=host.docker.internal
DB_PORT=3316
DB_SCHEMA=devnogi
DB_USER=devnogi
DB_PASSWORD=local-dev-only
KAFKA_BOOTSTRAP_SERVERS=host.docker.internal:9102
KAFKA_CONSUMER_GROUP_ID=devnogi-auth-local
BASE_URL=http://localhost:8091
GOOGLE_CLIENT_ID=local-placeholder
GOOGLE_CLIENT_SECRET=local-placeholder
KAKAO_CLIENT_ID=local-placeholder
KAKAO_CLIENT_SECRET=local-placeholder
NAVER_CLIENT_ID=local-placeholder
NAVER_CLIENT_SECRET=local-placeholder
MAIL_USERNAME=local@example.invalid
MAIL_PASSWORD=local-placeholder
AWS_REGION=ap-northeast-2
AWS_ACCESS_KEY=local-placeholder
AWS_SECRET_KEY=local-placeholder
OCI_NAMESPACE=local-placeholder
S3_BUCKET=local-bucket
USER_VERIFICATION_HASH_SECRET=local-only-verification-secret
JWT_SECRET_KEY=local-development-only-key-change-before-any-shared-use
JWT_ACCESS_TOKEN_VALIDITY=3600
JWT_REFRESH_TOKEN_VALIDITY=86400
