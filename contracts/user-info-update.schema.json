{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/devnogi/devnogi-auth-server/contracts/user-info-update.schema.json",
  "title": "USER_INFO_UPDATE_EVENT",
  "type": "object",
  "properties": {
    "activityGrade": {
      "type": ["string", "null"],
      "enum": ["APPRENTICE", "SENIOR", "EXPERT", "CHAMPION", "MASTER", "GRANDMASTER", null],
      "description": "Activity rank, separate from role. Optional for old producers; hidden when unverified."
    },
    "id": {
      "type": "integer",
      "description": "사용자 식별자"
    },
    "nickname": {
      "type": "string",
      "minLength": 1,
      "description": "표시 닉네임"
    },
    "profileImageUrl": {
      "type": [
        "string",
        "null"
      ],
      "description": "프로필 이미지 URL, 없으면 null"
    },
    "serverName": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "description": "마비노기 서버명. 일반/소셜 가입 직후 인증 전에는 null; 필드는 payload에 포함된다."
    },
    "verified": {
      "type": "boolean",
      "description": "마비노기 사용자 인증 상태"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "description": "사용자별 단조 증가 스냅샷 revision. 구형 이벤트에는 없을 수 있다."
    }
  },
  "required": [
    "id",
    "nickname",
    "serverName",
    "verified"
  ],
  "additionalProperties": true
}
